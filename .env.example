# Local validation only. Copy to .env if running outside an environment secret manager.
# Never commit .env or paste credentials into chat.
# Prefer your cloud environment's protected Secrets settings for credentials.
# The default is live; no automatic mock fallback.
MAG_MODE=live
HOST=127.0.0.1
PORT=5173
# Example supported Pi catalog selection; uses an EXISTING authorized credential.
PI_PROVIDER=anthropic
PI_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=   (set in protected environment settings)
# Alternative: PI_PROVIDER=openai, PI_MODEL=<available model id>, OPENAI_API_KEY in Secrets.
# Optional paths to existing Pi setup; files remain on the server:
# PI_AUTH_PATH=/absolute/path/to/existing/pi/auth.json
# PI_MODELS_PATH=/absolute/path/to/existing/pi/models.json

# Local material/progress retention and per-lesson limits (not a monetary cap).
MAG_DATA_DIR=.mag-lessons
MAG_MAX_BEATS=80
MAG_TOKEN_BUDGET=200000
